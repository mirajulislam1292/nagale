# Public API origin; never put a token in a VITE_ value.
VITE_API_BASE_URL=/api
# Enable mock data and review tools until a backend exists.
VITE_DEMO_MODE=true
# Initial locale; user preference can override it.
VITE_DEFAULT_LOCALE=en
# Public canonical origin.
VITE_SITE_URL=https://nagale.app
# Optional public analytics identifier; empty disables collection.
VITE_ANALYTICS_ID=
